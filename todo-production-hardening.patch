diff -ruN '--exclude=secrets' '--exclude=target' '--exclude=.git' '--exclude=.idea' /mnt/data/todo_original/.github/workflows/ci.yml /mnt/data/todo_work/todo/.github/workflows/ci.yml
--- /mnt/data/todo_original/.github/workflows/ci.yml	1970-01-01 00:00:00.000000000 +0000
+++ /mnt/data/todo_work/todo/.github/workflows/ci.yml	2026-10-19 02:44:48.086820214 +0000
@@ -0,0 +1,52 @@
+name: rust-production-gate
+
+on:
+  push:
+  pull_request:
+
+permissions:
+  contents: read
+
+env:
+  CARGO_TERM_COLOR: always
+
+jobs:
+  verify:
+    runs-on: ubuntu-latest
+    timeout-minutes: 45
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Toolchain
+        run: |
+          rustup toolchain install 1.99.1 --profile minimal --component rustfmt,clippy
+          rustup override set 1.99.1
+          rustc --version
+          cargo --version
+
+      - name: Repository preflight
+        run: bash scripts/check_workspace.sh --root . --mode preflight
+
+      - name: Formatting
+        run: cargo fmt --all -- --check
+
+      - name: Check
+        run: cargo check --workspace --all-targets --locked
+
+      - name: Clippy
+        run: cargo clippy --workspace --all-targets --locked -- -D warnings
+
+      - name: Tests
+        run: cargo test --workspace --locked
+
+      - name: Release tests
+        run: cargo test --workspace --release --locked
+
+      - name: Release build
+        run: cargo build --workspace --release --locked
+
+      - name: RustSec audit
+        run: |
+          cargo install cargo-audit --locked
+          cargo audit
